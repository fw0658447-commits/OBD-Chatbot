DATABASE_URL=postgresql://trading_user:trading_password@localhost:5432/trading_cockpit
REDIS_URL=redis://localhost:6379
MARKET_DATA_PROVIDER=free
MARKET_DATA_API_KEY=

# v1.4 online identifiers / internet analysis
# OpenFIGI maps ISIN/WKN/FIGI to instrument metadata. Finnhub/Alpha Vantage add fundamentals/news/sentiment.
OPENFIGI_API_KEY=
FINNHUB_API_KEY=
ALPHA_VANTAGE_API_KEY=
INTERNET_ANALYSIS_PROVIDER=auto
BOT_MODE=paper
NEXT_PUBLIC_API_BASE_URL=auto

MODEL_STORAGE_PATH=/tmp/trading-cockpit-models

# v1.1 real-market-readiness settings
QUOTE_CACHE_TTL_SECONDS=10
CANDLE_CACHE_TTL_SECONDS=60
MARKET_PROVIDER_FALLBACK_ENABLED=true
BLOCK_TRADES_ON_DATA_QUALITY_FAIL=true
MIN_DATA_QUALITY_SCORE=70
PAPER_SPREAD_BPS=4
PAPER_SLIPPAGE_BPS=2
PAPER_COMMISSION_BPS=1
PAPER_MIN_COMMISSION=0
LIVE_TRADING_HARD_LOCKED=true

# v1.2 validation / monitoring gates
ENFORCE_VALIDATION_GATE=false
MIN_CLOSED_TRADES_FOR_RELEASE=100
MIN_PROFIT_FACTOR_FOR_RELEASE=1.15
MIN_WIN_RATE_FOR_RELEASE=45
MAX_DRAWDOWN_PERCENT_FOR_RELEASE=12
MIN_EXPECTANCY_PER_TRADE_FOR_RELEASE=0

# iPadOS / GitHub Codespaces
# Keep NEXT_PUBLIC_API_BASE_URL=auto in Codespaces. The frontend uses /api/backend proxy.
# For local desktop non-Docker development you may set http://localhost:8000.
